{
  "name": "f1stories-site",
  "version": "1.0.0",
  "description": "F1 Stories static website \u2014 build scripts for the blog publishing pipeline.",
  "private": true,
  "scripts": {
    "build": "npm run build:html && npm run build:youtube && npm run build:blog && npm run build:assets",
    "build:blog": "node blog-module/build/index.js",
    "build:blog:force": "node blog-module/build/index.js --force",
    "build:html": "node scripts/build/include.mjs",
    "build:logo": "node scripts/build/optimize-logo.mjs",
    "build:driver-headshots": "node scripts/build/fetch-driver-headshots.mjs",
    "build:team-logos": "node scripts/build/fetch-team-logos.mjs",
    "build:youtube": "node scripts/build/fetch-youtube.mjs",
    "build:standings-data": "node scripts/build/refresh-standings-data.mjs",
    "build:images": "npm run build:logo && npm run build:driver-headshots && npm run build:team-logos",
    "build:article-image-backfill": "node scripts/build/backfill-article-image-attrs.mjs",
    "build:image-variants": "node blog-module/generate-image-variants.js --run",
    "build:fonts": "node scripts/build/download-fonts.mjs && node scripts/build/download-home-fonts.mjs",
    "build:icons": "node scripts/build/build-icon-sprite.mjs",
    "build:bootstrap": "sass styles/vendor/bootstrap.slim.scss styles/vendor/bootstrap.slim.css --style=compressed --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function",
    "build:assets": "npm run build:sponsors && node scripts/build/build-icon-sprite.mjs && npm run build:bootstrap && node scripts/build/minify.mjs && node scripts/build/stamp-html.mjs",
    "build:assets:minify": "node scripts/build/minify.mjs",
    "build:assets:stamp": "npm run build:html && node scripts/build/stamp-html.mjs",
    "build:assets:watch": "node scripts/build/minify.mjs --watch",
    "check:assets": "node scripts/build/check-generated-assets.mjs",
    "preview": "npm run build:assets && npm run check:assets && node scripts/serve-site.mjs",
    "build:public": "npm run pages:guard && npm run build:html && npm run build:blog && npm run build:assets && npm run build:data-contracts && node scripts/build/public-artifact.mjs && node scripts/build/validate-public-artifact.mjs",
    "build:data-contracts": "node scripts/build/validate-data-contracts.mjs",
    "build:check": "node scripts/build/generated-drift-guard.mjs",
    "test:blog": "npm run test:taxonomy && node blog-module/build/__tests__/run-golden.js",
    "test:taxonomy": "node --test blog-module/build/__tests__/taxonomy*.test.js",
    "test:author": "node --test scripts/author/__tests__/*.test.mjs",
    "test:standings": "node --test standings/core/__tests__/*.test.mjs",
    "test:security": "node --test scripts/build/__tests__/security-policy.test.mjs scripts/quality/__tests__/*.test.mjs",
    "pages:guard": "node scripts/build/pages-source-guard.mjs",
    "quality:rendering": "node scripts/quality/rendering-sink-guard.mjs",
    "quality:rendering:update": "node scripts/quality/rendering-sink-guard.mjs --update",
    "quality:static": "node scripts/quality/static-source-guard.mjs && node scripts/quality/important-guard.mjs && npm run quality:rendering",
    "audit:runtime": "node scripts/quality/runtime-audit.mjs",
    "security:headers": "node scripts/quality/security-headers-verify.mjs",
    "perf:budget": "node scripts/perf/size-guard.mjs",
    "perf:budget:update": "node scripts/perf/size-guard.mjs --update",
    "perf:article-media": "node scripts/perf/article-media-guard.mjs",
    "perf:article-media:update": "node scripts/perf/article-media-guard.mjs --update",
    "build:article-originals": "node scripts/build/normalize-article-originals.mjs",
    "perf:images": "node scripts/perf/public-image-guard.mjs",
    "qa:visual": "node scripts/perf/visual-qa.mjs",
    "qa:author-images": "node scripts/perf/author-image-ingest-check.mjs",
    "test:consent": "node scripts/perf/consent-guard.mjs",
    "perf:lighthouse": "node scripts/perf/lighthouse-guard.mjs",
    "verify": "npm run build:public && npm run build:check && npm run quality:static && npm run audit:runtime && npm run test:blog && npm run test:author && npm run test:standings && npm run test:security && npm run perf:budget && npm run perf:article-media && npm run perf:images && npm run qa:author-images && npm run test:consent && npm run qa:visual && npm run perf:lighthouse",
    "build:sponsors": "node scripts/build/normalize-sponsors.mjs",
    "test:build": "node --test scripts/build/__tests__/*.test.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.12",
    "mammoth": "^1.8.0",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.1",
    "lighthouse": "^13.5.0",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "sass": "^1.105.0"
  }
}
